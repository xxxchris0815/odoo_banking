<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="online_bank_statement_provider_form_gc_payments" model="ir.ui.view">
        <field name="name">online.bank.statement.provider.form.gocardless.payments</field>
        <field name="model">online.bank.statement.provider</field>
        <field
            name="inherit_id"
            ref="account_statement_import_online.online_bank_statement_provider_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <group
                    string="GoCardless Payments"
                    invisible="service != 'gocardless_payments'"
                    name="gocardless_payments_help"
                >
                    <field
                        name="password"
                        password="True"
                        string="Access Token"
                    />
                    <field
                        name="passphrase"
                        password="True"
                        string="Webhook-Secret"
                    />
                    <field
                        name="api_base"
                        string="API-Adresse"
                        placeholder="leer = Live (api.gocardless.com)"
                    />
                    <div colspan="2" class="text-muted">
                        <p>
                            Access Token aus dem GoCardless-Dashboard (Developers).
                            Webhook-Secret vom Endpoint
                            https://DEINE-DOMAIN/gocardless/payments/webhook
                            API-Adresse leer lassen für Live; Sandbox:
                            https://api-sandbox.gocardless.com
                        </p>
                    </div>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
