<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="online_bank_statement_provider_form_jeeves">
        <field name="name">online.bank.statement.provider.form.jeeves</field>
        <field name="model">online.bank.statement.provider</field>
        <field
            name="inherit_id"
            ref="account_statement_import_online.online_bank_statement_provider_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='main']" position="inside">
                <group
                    name="jeeves_mcp"
                    string="Jeeves MCP"
                    invisible="service != 'jeeves'"
                >
                    <group>
                        <field
                            name="api_base"
                            string="MCP URL"
                            placeholder="https://mcp-prod.jeev.es/mcp"
                            groups="base.group_no_one"
                        />
                        <field
                            name="username"
                            string="Account id"
                            required="service == 'jeeves'"
                        />
                        <field
                            name="password"
                            string="MCP API key"
                            password="True"
                            required="service == 'jeeves'"
                        />
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
