<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="online_bank_statement_provider_form_zen" model="ir.ui.view">
        <field name="name">online.bank.statement.provider.form.zen</field>
        <field name="model">online.bank.statement.provider</field>
        <field
            name="inherit_id"
            ref="account_statement_import_online.online_bank_statement_provider_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <group
                    string="ZEN.COM"
                    invisible="service != 'zen'"
                    name="zen_help"
                >
                    <field
                        name="password"
                        password="True"
                        string="ZEN API-Key"
                    />
                    <field
                        name="username"
                        string="Account-UUID"
                        placeholder="optional, wenn die Journal-IBAN eindeutig ist"
                    />
                    <field
                        name="api_base"
                        string="API-Adresse"
                        placeholder="leer = https://api-services.zen.com"
                    />
                    <div colspan="2" class="text-muted">
                        <p>
                            API-Key der Transfers-API, nicht der Terminal-Key aus
                            my.zen.com Payments. API-Adresse leer = Live;
                            Test: https://api-services.zen-test.com
                        </p>
                    </div>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
