<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_partner_form_jeeves_vendor" model="ir.ui.view">
        <field name="name">res.partner.form.jeeves.vendor</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_open_jeeves_vendor_wizard"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-university"
                >
                    <div class="o_stat_info">
                        <span class="o_stat_text">Jeeves</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//field[@name='email'][1]" position="after">
                <label for="jeeves_vendor_id"/>
                <div class="o_row">
                    <field name="jeeves_vendor_id" placeholder="Jeeves vendor id"/>
                    <button
                        name="action_open_jeeves_vendor_wizard"
                        type="object"
                        string="Jeeves laden / nach Odoo"
                        class="btn-secondary"
                    />
                </div>
            </xpath>
        </field>
    </record>
</odoo>
