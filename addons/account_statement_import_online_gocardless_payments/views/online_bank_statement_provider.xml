<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="online_bank_statement_provider_form_gc_payments" model="ir.ui.view">
        <field name="name">online.bank.statement.provider.form.gocardless.payments</field>
        <field name="model">online.bank.statement.provider</field>
        <field
            name="inherit_id"
            ref="account_statement_import_online.online_bank_statement_provider_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='main']" position="inside">
                <group
                    name="gocardless_payments"
                    string="Credentials"
                    invisible="service != 'gocardless_payments'"
                >
                    <field
                        name="password"
                        password="True"
                        string="Access Token"
                        required="service == 'gocardless_payments'"
                    />
                    <field
                        name="passphrase"
                        password="True"
                        string="Webhook-Secret"
                    />
                    <field
                        name="api_base"
                        string="API-Adresse"
                        placeholder="leer = Live (api.gocardless.com)"
                    />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
