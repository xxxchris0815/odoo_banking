<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="online_bank_statement_provider_form_zen" model="ir.ui.view">
        <field name="name">online.bank.statement.provider.form.zen</field>
        <field name="model">online.bank.statement.provider</field>
        <field
            name="inherit_id"
            ref="account_statement_import_online.online_bank_statement_provider_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <group
                    string="ZEN.COM"
                    invisible="service != 'zen'"
                    name="zen_help"
                >
                    <div colspan="2" class="text-muted">
                        <p>
                            Password = ZEN Transfers API key.
                            Username = optional account UUID (otherwise the journal IBAN is used).
                            API Base empty = production
                            (https://api-services.zen.com); use
                            https://api-services.zen-test.com for the test environment.
                        </p>
                    </div>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
