<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_jeeves_bulk_export_wizard_form" model="ir.ui.view">
        <field name="name">jeeves.bulk.export.wizard.form</field>
        <field name="model">jeeves.bulk.export.wizard</field>
        <field name="arch" type="xml">
            <form string="Jeeves Bulk Payments">
                <div class="oe_title">
                    <p>
                        Datei speichern und in der Jeeves-Web-App unter
                        <strong>Bulk Payments</strong> importieren.
                        Das ist kein Kontoauszug.
                    </p>
                </div>
                <group>
                    <field name="line_count" string="Rechnungen"/>
                    <field name="filename"/>
                    <field name="note" nolabel="1" colspan="2"/>
                    <field name="data" filename="filename" widget="binary"/>
                </group>
                <footer>
                    <button special="cancel" string="Schließen" class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
