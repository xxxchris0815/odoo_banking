<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="online_bank_statement_provider_form_paypal">
        <field name="name">online.bank.statement.provider.form.paypal</field>
        <field name="model">online.bank.statement.provider</field>
        <field
            name="inherit_id"
            ref="account_statement_import_online.online_bank_statement_provider_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='main']" position="inside">
                <group
                    name="paypal_reporting"
                    string="PayPal"
                    invisible="service != 'paypal'"
                >
                    <group>
                        <field name="paypal_module_version" readonly="1" />
                        <field
                            name="api_base"
                            string="API base"
                            groups="base.group_no_one"
                        />
                        <field
                            name="username"
                            string="Client ID"
                            required="service == 'paypal'"
                        />
                        <field
                            name="password"
                            string="Secret"
                            password="True"
                            required="service == 'paypal'"
                        />
                        <field
                            name="paypal_webhook_url"
                            string="Webhook URL"
                            widget="CopyClipboardChar"
                            readonly="1"
                        />
                        <field name="paypal_webhook_token" invisible="1" />
                        <field
                            name="paypal_webhook_id"
                            string="Webhook ID"
                            placeholder="from PayPal after adding the URL"
                        />
                        <button
                            name="action_paypal_register_webhook"
                            type="object"
                            string="Register webhook"
                            class="btn-secondary"
                            invisible="not username or not password or not paypal_webhook_url"
                        />
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
